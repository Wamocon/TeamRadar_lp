{
  "name": "team-radar-landing-page",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npx -y serve . -p 8080",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:ci": "jest --ci && playwright test",
    "lint:html": "htmlhint \"*.html\"",
    "lint:css": "stylelint \"*.css\"",
    "lint": "npm run lint:html && npm run lint:css",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "ancestorSeparator": " › "
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "htmlhint": "^1.9.2",
    "jest": "^29.7.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1"
  }
}
